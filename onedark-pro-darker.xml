<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="onedark-pro-darker" name="One Dark Pro Darker" kind="dark">
  <description>Atom One Dark Pro (Darker variant) theme based on VS Code colors</description>

  <!-- One Dark Pro Darker Palette -->
  <color name="odpd_bg"            value="#23272e"/>
  <color name="odpd_fg"            value="#abb2bf"/>
  <color name="odpd_cursor"        value="#528bff"/>
  <color name="odpd_selection"     value="#353a44"/>
  <color name="odpd_current_line"  value="#2c313c"/>
  <color name="odpd_line_numbers"  value="#495162"/>
  <color name="odpd_bracket_match" value="#515a6b"/>
  <color name="odpd_whitespace"    value="#3b4048"/>
  <color name="odpd_comment"       value="#7f848e"/>
  <color name="odpd_coral"         value="#e06c75"/>
  <color name="odpd_whiskey"       value="#d19a66"/>
  <color name="odpd_chalky"        value="#e5c07b"/>
  <color name="odpd_green"         value="#98c379"/>
  <color name="odpd_cyan"          value="#56b6c2"/>
  <color name="odpd_malibu"        value="#61afef"/>
  <color name="odpd_purple"        value="#c678dd"/>
  <color name="odpd_error"         value="#c24038"/>
  <color name="odpd_white"         value="#ffffff"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="odpd_fg" background="odpd_bg"/>
  <style name="selection"                   foreground="odpd_fg" background="odpd_selection"/>
  <style name="cursor"                      foreground="odpd_cursor"/>
  <style name="secondary-cursor"            foreground="odpd_cursor"/>
  <style name="current-line"                background="odpd_current_line"/>
  <style name="line-numbers"                foreground="odpd_line_numbers" background="odpd_bg"/>
  <style name="draw-spaces"                 foreground="odpd_whitespace"/>
  <style name="background-pattern"          background="odpd_bg"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="odpd_white" background="odpd_bracket_match"/>
  <style name="bracket-mismatch"            foreground="odpd_white" background="odpd_error"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="odpd_line_numbers" background="odpd_current_line"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="odpd_bg" background="odpd_whiskey"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="odpd_comment"/>
  <style name="def:shebang"                 foreground="odpd_comment"/>
  <style name="def:doc-comment-element"     italic="false"/>

  <!-- Constants & Literals -->
  <style name="def:constant"                foreground="odpd_whiskey"/>
  <style name="def:string"                  foreground="odpd_green"/>
  <style name="def:special-char"            foreground="odpd_cyan"/>
  <style name="def:special-constant"        foreground="odpd_whiskey"/>
  <style name="def:floating-point"          foreground="odpd_whiskey"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="odpd_coral"/>

  <!-- Statements & Keywords -->
  <style name="def:statement"               foreground="odpd_purple"/>

  <!-- Types & Classes -->
  <style name="def:type"                    foreground="odpd_chalky"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="false"/>
  <style name="def:strong-emphasis"         foreground="odpd_chalky"/>
  <style name="def:inline-code"             foreground="odpd_green"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="odpd_malibu"/>
  <style name="def:link-symbol"             foreground="odpd_purple"/>
  <style name="def:link-destination"        foreground="odpd_malibu" italic="false" underline="single"/>
  <style name="def:heading"                 foreground="odpd_coral"/>
  <style name="def:thematic-break"          foreground="odpd_green"/>
  <style name="def:preformatted-section"    foreground="odpd_green"/>
  <style name="def:list-marker"             foreground="odpd_coral"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="odpd_purple"/>
  <style name="def:error"                   foreground="odpd_white" background="odpd_error"/>
  <style name="def:warning"                 foreground="odpd_bg" background="odpd_whiskey"/>
  <style name="def:note"                    foreground="odpd_malibu"/>
  <style name="def:net-address"             foreground="odpd_malibu" italic="false" underline="single"/>
</style-scheme>