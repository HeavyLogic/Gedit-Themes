<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rosepine-moon-bold-italic" name="Rose Pine Moon (Bold+Italic)" kind="dark">
  <description>All natural pine, faux fur and a bit of soho vibes for Gedit (Moon variant)</description>

  <!-- Rose Pine Moon Palette -->
  <color name="moon_base"       value="#232136"/>
  <color name="moon_surface"    value="#2a273f"/>
  <color name="moon_overlay"    value="#393552"/>
  <color name="moon_muted"      value="#6e6a86"/>
  <color name="moon_subtle"     value="#908caa"/>
  <color name="moon_text"       value="#e0def4"/>
  <color name="moon_love"       value="#eb6f92"/>
  <color name="moon_gold"       value="#f6c177"/>
  <color name="moon_rose"       value="#ea9a97"/>
  <color name="moon_pine"       value="#3e8fb0"/>
  <color name="moon_foam"       value="#9ccfd8"/>
  <color name="moon_iris"       value="#c4a7e7"/>
  <color name="moon_hl_low"     value="#2a283e"/>
  <color name="moon_hl_med"     value="#44415a"/>
  <color name="moon_hl_high"    value="#56526e"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="moon_text" background="moon_base"/>
  <style name="selection"                   foreground="moon_text" background="moon_hl_med"/>
  <style name="cursor"                      foreground="moon_text"/>
  <style name="secondary-cursor"            foreground="moon_text"/>
  <style name="current-line"                background="moon_surface"/>
  <style name="line-numbers"                foreground="moon_muted" background="moon_base"/>
  <style name="draw-spaces"                 foreground="moon_muted"/>
  <style name="background-pattern"          background="moon_base"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="moon_base" background="moon_pine" bold="true"/>
  <style name="bracket-mismatch"            foreground="moon_text" background="moon_love"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="moon_muted" background="moon_surface"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="moon_base" background="moon_foam"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="moon_muted" italic="true"/>
  <style name="def:shebang"                 foreground="moon_muted" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="moon_love"/>
  <style name="def:string"                  foreground="moon_gold"/>
  <style name="def:special-char"            foreground="moon_rose"/>
  <style name="def:special-constant"        foreground="moon_rose"/>
  <style name="def:floating-point"          foreground="moon_rose"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="moon_text"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="moon_pine" bold="true"/>

  <!-- Types -->
  <style name="def:type"                    foreground="moon_foam" bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="moon_gold" bold="true"/>
  <style name="def:inline-code"             foreground="moon_gold"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="moon_iris"/>
  <style name="def:link-symbol"             foreground="moon_foam" bold="true"/>
  <style name="def:link-destination"        foreground="moon_foam" italic="true" underline="single"/>
  <style name="def:heading"                 foreground="moon_iris" bold="true"/>
  <style name="def:thematic-break"          foreground="moon_gold" bold="true"/>
  <style name="def:preformatted-section"    foreground="moon_gold"/>
  <style name="def:list-marker"             foreground="moon_iris" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="moon_iris"/>
  <style name="def:error"                   foreground="moon_base" background="moon_love" bold="true"/>
  <style name="def:warning"                 foreground="moon_base" background="moon_gold"/>
  <style name="def:note"                    foreground="moon_foam" bold="true"/>
  <style name="def:net-address"             italic="true" underline="single"/>
</style-scheme>